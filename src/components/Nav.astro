---
const navLinks = [
  { href: '/blog',       label: 'Field Notes' },
  { href: '/calculator', label: 'Lumber Calc' },
  { href: '/species',    label: 'Species Guide' },
  { href: '/community',  label: 'Community' },
];

const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-50 border-b border-forest/10 bg-cream/90 backdrop-blur-sm">
  <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">

    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="w-8 h-8 bg-forest flex items-center justify-center flex-shrink-0 group-hover:bg-bark transition-colors">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
          <!-- Stylized saw blade -->
          <circle cx="9" cy="9" r="7" stroke="#C8881A" stroke-width="1.5" fill="none"/>
          <circle cx="9" cy="9" r="2.5" fill="#C8881A"/>
          <line x1="9" y1="2" x2="9" y2="4" stroke="#C8881A" stroke-width="1.5" stroke-linecap="round"/>
          <line x1="9" y1="14" x2="9" y2="16" stroke="#C8881A" stroke-width="1.5" stroke-linecap="round"/>
          <line x1="2" y1="9" x2="4" y2="9" stroke="#C8881A" stroke-width="1.5" stroke-linecap="round"/>
          <line x1="14" y1="9" x2="16" y2="9" stroke="#C8881A" stroke-width="1.5" stroke-linecap="round"/>
          <line x1="3.93" y1="3.93" x2="5.34" y2="5.34" stroke="#C8881A" stroke-width="1.5" stroke-linecap="round"/>
          <line x1="12.66" y1="12.66" x2="14.07" y2="14.07" stroke="#C8881A" stroke-width="1.5" stroke-linecap="round"/>
          <line x1="14.07" y1="3.93" x2="12.66" y2="5.34" stroke="#C8881A" stroke-width="1.5" stroke-linecap="round"/>
          <line x1="5.34" y1="12.66" x2="3.93" y2="14.07" stroke="#C8881A" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </div>
      <div>
        <div class="font-display font-bold text-forest text-sm leading-tight tracking-wide">South Shore Sawyer</div>
        <div class="font-mono text-[9px] text-amber tracking-widest uppercase">Plympton, MA</div>
      </div>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-8">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          class={`nav-link ${currentPath.startsWith(href) ? 'text-amber' : ''}`}
        >
          {label}
        </a>
      ))}
    </nav>

    <!-- CTA -->
    <div class="flex items-center gap-4">
      <a href="/#newsletter" class="btn-primary hidden sm:inline-flex">
        Join the Mill
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
          <path d="M2 6h8M6 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>

      <!-- Mobile menu button -->
      <button id="menu-btn" class="md:hidden p-2 text-forest" aria-label="Open menu">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
          <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-cream border-t border-forest/10 px-6 py-4">
    {navLinks.map(({ href, label }) => (
      <a href={href} class="block nav-link py-3 border-b border-forest/5 last:border-0">
        {label}
      </a>
    ))}
    <a href="/#newsletter" class="btn-primary mt-4 w-full justify-center">Join the Mill</a>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
