---
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard — South Shore Sawyer Admin</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=IBM+Plex+Mono:wght@400;500&family=Source+Serif+4:wght@400&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --forest: #1C2E1C;
      --bark: #3D2410;
      --amber: #C8881A;
      --amber-lt: #E8A832;
      --sawdust: #F7F0E4;
      --cream: #FAF6EE;
      --steel: #4A5568;
      --steel-lt: #718096;
      --danger: #A32D2D;
      --danger-lt: #FCEBEB;
      --success: #27500A;
      --success-lt: #EAF3DE;
    }

    body {
      font-family: 'IBM Plex Mono', monospace;
      background: #F1EFE8;
      color: var(--forest);
      min-height: 100vh;
    }

    /* ── Layout ── */
    .layout { display: flex; min-height: 100vh; }

    /* ── Sidebar ── */
    .sidebar {
      width: 220px;
      flex-shrink: 0;
      background: var(--forest);
      display: flex;
      flex-direction: column;
      position: fixed;
      top: 0; bottom: 0; left: 0;
      z-index: 10;
    }

    .sidebar-logo {
      padding: 1.5rem;
      border-bottom: 1px solid rgba(200,136,26,0.2);
    }
    .sidebar-logo-title { font-family: 'Playfair Display', serif; font-size: 15px; color: var(--cream); font-weight: 700; }
    .sidebar-logo-sub   { font-size: 9px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--amber); margin-top: 3px; }

    .sidebar-nav { padding: 1rem 0; flex: 1; }
    .nav-item {
      display: flex; align-items: center; gap: 10px;
      padding: 10px 1.5rem;
      font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase;
      color: rgba(247,240,228,0.5);
      cursor: pointer; transition: all 0.15s;
      border-left: 2px solid transparent;
      text-decoration: none;
    }
    .nav-item:hover, .nav-item.active {
      color: var(--amber);
      background: rgba(200,136,26,0.08);
      border-left-color: var(--amber);
    }
    .nav-dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; flex-shrink: 0; }

    .sidebar-footer {
      padding: 1rem 1.5rem;
      border-top: 1px solid rgba(200,136,26,0.15);
    }
    .signout-btn {
      width: 100%; background: transparent; border: 1px solid rgba(200,136,26,0.3);
      color: rgba(247,240,228,0.4); font-family: 'IBM Plex Mono', monospace;
      font-size: 10px; letter-spacing: 0.15em; text-transform: uppercase;
      padding: 8px; cursor: pointer; transition: all 0.15s;
    }
    .signout-btn:hover { border-color: var(--amber); color: var(--amber); }

    /* ── Main content ── */
    .main { margin-left: 220px; flex: 1; padding: 2rem; }

    /* ── Top bar ── */
    .topbar {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 2rem;
    }
    .page-title { font-family: 'Playfair Display', serif; font-size: 26px; font-weight: 700; }
    .page-sub { font-size: 11px; color: var(--steel-lt); margin-top: 2px; }

    /* ── Buttons ── */
    .btn-primary {
      display: inline-flex; align-items: center; gap: 8px;
      background: var(--forest); color: var(--amber);
      font-family: 'IBM Plex Mono', monospace;
      font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase;
      padding: 10px 18px; border: none; cursor: pointer;
      transition: background 0.15s; text-decoration: none;
    }
    .btn-primary:hover { background: var(--bark); }

    .btn-ghost {
      display: inline-flex; align-items: center; gap: 6px;
      background: transparent; color: var(--steel);
      font-family: 'IBM Plex Mono', monospace;
      font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase;
      padding: 6px 12px; border: 1px solid rgba(74,85,104,0.3);
      cursor: pointer; transition: all 0.15s;
    }
    .btn-ghost:hover { border-color: var(--forest); color: var(--forest); }

    .btn-danger {
      display: inline-flex; align-items: center; gap: 6px;
      background: transparent; color: var(--danger);
      font-family: 'IBM Plex Mono', monospace;
      font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase;
      padding: 6px 12px; border: 1px solid rgba(163,45,45,0.3);
      cursor: pointer; transition: all 0.15s;
    }
    .btn-danger:hover { background: var(--danger-lt); }

    /* ── Stats ── */
    .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 2rem; }
    .stat-card {
      background: white; border: 0.5px solid rgba(28,46,28,0.1);
      padding: 1.25rem; border-top: 3px solid var(--amber);
    }
    .stat-val { font-family: 'Playfair Display', serif; font-size: 32px; font-weight: 700; color: var(--forest); }
    .stat-lbl { font-size: 10px; letter-spacing: 0.15em; text-transform: uppercase; color: var(--steel-lt); margin-top: 4px; }

    /* ── Posts table ── */
    .table-wrap { background: white; border: 0.5px solid rgba(28,46,28,0.1); overflow: hidden; }
    .table-header {
      display: flex; align-items: center; justify-content: space-between;
      padding: 1rem 1.25rem;
      border-bottom: 1px solid rgba(28,46,28,0.08);
    }
    .table-title { font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--steel); }

    table { width: 100%; border-collapse: collapse; }
    th {
      font-size: 10px; letter-spacing: 0.15em; text-transform: uppercase;
      color: var(--steel-lt); text-align: left;
      padding: 10px 16px; border-bottom: 1px solid rgba(28,46,28,0.08);
      background: #F9F7F3;
    }
    td { padding: 14px 16px; border-bottom: 1px solid rgba(28,46,28,0.05); font-size: 13px; vertical-align: middle; }
    tr:last-child td { border-bottom: none; }
    tr:hover td { background: #FDFCF9; }

    .post-title { font-family: 'Source Serif 4', serif; font-weight: 400; color: var(--forest); }
    .post-slug { font-size: 10px; color: var(--steel-lt); margin-top: 2px; font-family: 'IBM Plex Mono', monospace; }

    .category-badge {
      display: inline-block; font-size: 10px; letter-spacing: 0.08em;
      padding: 2px 8px; background: var(--sawdust);
      color: var(--steel); border: 1px solid rgba(28,46,28,0.1);
    }

    .featured-badge {
      display: inline-block; font-size: 10px; letter-spacing: 0.08em;
      padding: 2px 8px; background: #FAEEDA;
      color: #633806; border: 1px solid #FAC775;
    }

    .actions { display: flex; gap: 6px; }

    /* ── Toast ── */
    .toast {
      position: fixed; bottom: 2rem; right: 2rem;
      background: var(--forest); color: var(--amber);
      font-size: 11px; letter-spacing: 0.1em;
      padding: 12px 20px; z-index: 100;
      transform: translateY(100px); opacity: 0;
      transition: all 0.3s ease;
    }
    .toast.show { transform: translateY(0); opacity: 1; }
    .toast.error { background: var(--danger); color: white; }

    /* ── Empty state ── */
    .empty {
      text-align: center; padding: 4rem 2rem;
      color: var(--steel-lt);
    }
    .empty-title { font-family: 'Playfair Display', serif; font-size: 20px; color: var(--steel); margin-bottom: 8px; }
    .empty-sub { font-size: 12px; margin-bottom: 1.5rem; }

    /* ── Loading ── */
    .loading { text-align: center; padding: 3rem; color: var(--steel-lt); font-size: 12px; }
    @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.4} }
    .loading { animation: pulse 1.5s infinite; }

    /* ── Confirm dialog ── */
    .overlay {
      display: none; position: fixed; inset: 0;
      background: rgba(28,46,28,0.6); z-index: 50;
      align-items: center; justify-content: center;
    }
    .overlay.show { display: flex; }
    .dialog {
      background: var(--cream); padding: 2rem; max-width: 380px; width: 90%;
      border-top: 4px solid var(--danger);
    }
    .dialog h3 { font-family: 'Playfair Display', serif; font-size: 20px; margin-bottom: 8px; }
    .dialog p { font-size: 13px; color: var(--steel); margin-bottom: 1.5rem; line-height: 1.6; font-family: 'Source Serif 4', serif; }
    .dialog-actions { display: flex; gap: 8px; justify-content: flex-end; }
  </style>
</head>
<body>

<div class="layout">

  <!-- Sidebar -->
  <aside class="sidebar">
    <div class="sidebar-logo">
      <div class="sidebar-logo-title">South Shore Sawyer</div>
      <div class="sidebar-logo-sub">Admin Panel</div>
    </div>
    <nav class="sidebar-nav">
      <div class="nav-item active" onclick="showSection('posts')">
        <div class="nav-dot"></div> All Posts
      </div>
      <div class="nav-item" onclick="showSection('new')">
        <div class="nav-dot"></div> New Post
      </div>
      <a href="/" target="_blank" class="nav-item">
        <div class="nav-dot"></div> View Site ↗
      </a>
    </nav>
    <div class="sidebar-footer">
      <button class="signout-btn" onclick="signOut()">Sign out</button>
    </div>
  </aside>

  <!-- Main -->
  <main class="main">

    <!-- SECTION: Posts list -->
    <div id="section-posts">
      <div class="topbar">
        <div>
          <div class="page-title">Field Notes</div>
          <div class="page-sub">Manage your blog posts</div>
        </div>
        <button class="btn-primary" onclick="showSection('new')">
          + New Post
        </button>
      </div>

      <div class="stats">
        <div class="stat-card">
          <div class="stat-val" id="stat-total">—</div>
          <div class="stat-lbl">Total posts</div>
        </div>
        <div class="stat-card">
          <div class="stat-val" id="stat-featured">—</div>
          <div class="stat-lbl">Featured</div>
        </div>
        <div class="stat-card">
          <div class="stat-val" id="stat-latest">—</div>
          <div class="stat-lbl">Latest post</div>
        </div>
      </div>

      <div class="table-wrap">
        <div class="table-header">
          <div class="table-title">All posts</div>
          <button class="btn-ghost" onclick="loadPosts()">↻ Refresh</button>
        </div>
        <div id="posts-container">
          <div class="loading">Loading posts...</div>
        </div>
      </div>
    </div>

    <!-- SECTION: New / Edit Post -->
    <div id="section-new" style="display:none">
      <div class="topbar">
        <div>
          <div class="page-title" id="editor-title">New Post</div>
          <div class="page-sub" id="editor-sub">Write a new field note</div>
        </div>
        <button class="btn-ghost" onclick="cancelEdit()">← Back to posts</button>
      </div>

      <div style="display:grid; grid-template-columns: 1fr 300px; gap: 1.5rem; align-items: start;">

        <!-- Editor -->
        <div style="background:white; border: 0.5px solid rgba(28,46,28,0.1); padding: 1.5rem; display:flex; flex-direction:column; gap:1.25rem;">

          <div>
            <label style="display:block; font-size:10px; letter-spacing:0.15em; text-transform:uppercase; color:var(--steel-lt); margin-bottom:6px;">Post title *</label>
            <input id="f-title" type="text" placeholder="e.g. Milling White Oak on the WM3"
              style="width:100%; border:1px solid rgba(28,46,28,0.15); background:var(--sawdust);
                     font-family:'Playfair Display',serif; font-size:20px; color:var(--forest);
                     padding:12px 16px; outline:none; transition:border-color 0.15s;"
              oninput="autoSlug()" />
          </div>

          <div>
            <label style="display:block; font-size:10px; letter-spacing:0.15em; text-transform:uppercase; color:var(--steel-lt); margin-bottom:6px;">Excerpt <span style="color:var(--steel-lt); font-size:9px;">(auto-generated if blank)</span></label>
            <textarea id="f-excerpt" rows="2" placeholder="One or two sentences that hook the reader..."
              style="width:100%; border:1px solid rgba(28,46,28,0.15); background:var(--sawdust);
                     font-family:'Source Serif 4',serif; font-size:14px; color:var(--forest);
                     padding:12px 16px; outline:none; resize:vertical; transition:border-color 0.15s; line-height:1.6;"></textarea>
          </div>

          <div>
            <label style="display:block; font-size:10px; letter-spacing:0.15em; text-transform:uppercase; color:var(--steel-lt); margin-bottom:6px;">
              Content * <span style="color:var(--steel-lt); font-size:9px;">(Markdown supported)</span>
            </label>
            <textarea id="f-content" rows="20" placeholder="Write your post here. Markdown is supported.&#10;&#10;## Heading&#10;&#10;Your content..."
              style="width:100%; border:1px solid rgba(28,46,28,0.15); background:var(--sawdust);
                     font-family:'IBM Plex Mono',monospace; font-size:13px; color:var(--forest);
                     padding:16px; outline:none; resize:vertical; transition:border-color 0.15s; line-height:1.8;"
              oninput="updateWordCount()"></textarea>
            <div style="font-size:10px; color:var(--steel-lt); margin-top:6px; text-align:right;">
              <span id="word-count">0</span> words · est. <span id="read-time">0</span> min read
            </div>
          </div>

          <div style="display:flex; gap:10px; padding-top:1rem; border-top:1px solid rgba(28,46,28,0.08);">
            <button class="btn-primary" id="save-btn" onclick="savePost()">Save Post →</button>
            <button class="btn-ghost" onclick="cancelEdit()">Cancel</button>
          </div>
        </div>

        <!-- Sidebar options -->
        <div style="display:flex; flex-direction:column; gap:12px;">

          <div style="background:white; border:0.5px solid rgba(28,46,28,0.1); padding:1.25rem;">
            <div style="font-size:10px; letter-spacing:0.15em; text-transform:uppercase; color:var(--steel-lt); margin-bottom:12px;">Post settings</div>

            <label style="display:block; font-size:10px; letter-spacing:0.12em; text-transform:uppercase; color:var(--steel-lt); margin-bottom:5px;">Category</label>
            <select id="f-category"
              style="width:100%; border:1px solid rgba(28,46,28,0.15); background:var(--sawdust);
                     font-family:'IBM Plex Mono',monospace; font-size:12px; color:var(--forest);
                     padding:8px 12px; outline:none; margin-bottom:12px; cursor:pointer;">
              <option>Field Notes</option>
              <option>Species</option>
              <option>Equipment</option>
              <option>Drying & Curing</option>
              <option>DIY & Builds</option>
              <option>Business</option>
            </select>

            <label style="display:block; font-size:10px; letter-spacing:0.12em; text-transform:uppercase; color:var(--steel-lt); margin-bottom:5px;">URL slug</label>
            <input id="f-slug" type="text" placeholder="auto-generated"
              style="width:100%; border:1px solid rgba(28,46,28,0.15); background:var(--sawdust);
                     font-family:'IBM Plex Mono',monospace; font-size:11px; color:var(--forest);
                     padding:8px 12px; outline:none; margin-bottom:12px;" />

            <label style="display:flex; align-items:center; gap:8px; cursor:pointer; font-size:11px; color:var(--steel);">
              <input id="f-featured" type="checkbox" style="width:14px; height:14px; cursor:pointer; accent-color:var(--amber);" />
              Mark as featured post
            </label>
          </div>

          <div style="background:var(--sawdust); border:1px solid rgba(28,46,28,0.1); padding:1.25rem;">
            <div style="font-size:10px; letter-spacing:0.15em; text-transform:uppercase; color:var(--steel-lt); margin-bottom:8px;">Markdown cheatsheet</div>
            <pre style="font-size:10px; color:var(--steel); line-height:1.8; white-space:pre-wrap;"># Heading 1
## Heading 2

**bold text**
*italic text*

- bullet item
- another item

1. numbered item
2. another item

> blockquote

[link text](url)

---  (horizontal rule)</pre>
          </div>

        </div>
      </div>
    </div>

  </main>
</div>

<!-- Delete confirm dialog -->
<div class="overlay" id="delete-overlay">
  <div class="dialog">
    <h3>Delete this post?</h3>
    <p id="delete-msg">This action cannot be undone. The post will be permanently removed.</p>
    <div class="dialog-actions">
      <button class="btn-ghost" onclick="closeDeleteDialog()">Cancel</button>
      <button class="btn-danger" id="confirm-delete-btn" onclick="confirmDelete()">Delete permanently</button>
    </div>
  </div>
</div>

<!-- Toast notification -->
<div class="toast" id="toast"></div>

<script is:inline>
  var API = '/api/blog';
  var token = null;
  var editingSlug = null;
  var pendingDeleteSlug = null;

  // ── Auth check ────────────────────────────────────────────────────────────
  function getToken() {
    return sessionStorage.getItem('sss_admin_token');
  }

  function checkAuth() {
    token = getToken();
    if (!token) {
      window.location.href = '/admin';
      return false;
    }
    return true;
  }

  // ── Toast ─────────────────────────────────────────────────────────────────
  function showToast(msg, isError) {
    var el = document.getElementById('toast');
    el.textContent = msg;
    el.className = 'toast' + (isError ? ' error' : '');
    el.classList.add('show');
    setTimeout(function() { el.classList.remove('show'); }, 3000);
  }

  // ── Section switching ─────────────────────────────────────────────────────
  function showSection(name) {
    document.getElementById('section-posts').style.display = name === 'posts' ? 'block' : 'none';
    document.getElementById('section-new').style.display  = name === 'new'   ? 'block' : 'none';
    document.querySelectorAll('.nav-item').forEach(function(el, i) {
      el.classList.toggle('active', (i === 0 && name === 'posts') || (i === 1 && name === 'new'));
    });
    if (name === 'posts') {
      editingSlug = null;
      clearEditor();
    }
  }

  // ── Load posts ────────────────────────────────────────────────────────────
  async function loadPosts() {
    var container = document.getElementById('posts-container');
    container.innerHTML = '<div class="loading">Loading posts...</div>';

    try {
      var res = await fetch(API + '/posts');
      var posts = await res.json();

      // Update stats
      document.getElementById('stat-total').textContent = posts.length;
      document.getElementById('stat-featured').textContent = posts.filter(function(p) { return p.featured; }).length;
      document.getElementById('stat-latest').textContent = posts.length ? posts[0].date.split(' ').slice(0,2).join(' ') : '—';

      if (!posts.length) {
        container.innerHTML = '<div class="empty"><div class="empty-title">No posts yet</div><div class="empty-sub">Write your first field note to get started.</div><button class="btn-primary" onclick="showSection(\'new\')">+ Write first post</button></div>';
        return;
      }

      var rows = posts.map(function(post) {
        return '<tr>' +
          '<td><div class="post-title">' + escHtml(post.title) + '</div><div class="post-slug">/' + post.slug + '</div></td>' +
          '<td><span class="category-badge">' + escHtml(post.category) + '</span>' +
            (post.featured ? ' <span class="featured-badge">Featured</span>' : '') + '</td>' +
          '<td style="font-size:11px; color:var(--steel-lt);">' + escHtml(post.date) + '</td>' +
          '<td style="font-size:11px; color:var(--steel-lt);">' + escHtml(post.readTime) + '</td>' +
          '<td><div class="actions">' +
            '<button class="btn-ghost" onclick="editPost(\'' + post.slug + '\')">Edit</button>' +
            '<button class="btn-danger" onclick="deletePost(\'' + post.slug + '\', \'' + escHtml(post.title) + '\')">Delete</button>' +
          '</div></td>' +
        '</tr>';
      }).join('');

      container.innerHTML = '<table>' +
        '<thead><tr><th>Title</th><th>Category</th><th>Date</th><th>Read time</th><th>Actions</th></tr></thead>' +
        '<tbody>' + rows + '</tbody>' +
        '</table>';

    } catch (e) {
      container.innerHTML = '<div class="empty"><div class="empty-title">Could not load posts</div><div class="empty-sub">Make sure the blog API worker is deployed and running.</div></div>';
    }
  }

  // ── Edit post ─────────────────────────────────────────────────────────────
  async function editPost(slug) {
    editingSlug = slug;
    showSection('new');
    document.getElementById('editor-title').textContent = 'Edit Post';
    document.getElementById('editor-sub').textContent = '/' + slug;
    document.getElementById('save-btn').textContent = 'Update Post →';

    try {
      var res = await fetch(API + '/posts/' + slug);
      var post = await res.json();
      document.getElementById('f-title').value    = post.title    || '';
      document.getElementById('f-excerpt').value  = post.excerpt  || '';
      document.getElementById('f-content').value  = post.content  || '';
      document.getElementById('f-category').value = post.category || 'Field Notes';
      document.getElementById('f-slug').value     = post.slug     || '';
      document.getElementById('f-featured').checked = !!post.featured;
      updateWordCount();
    } catch (e) {
      showToast('Could not load post', true);
      cancelEdit();
    }
  }

  // ── Save post ─────────────────────────────────────────────────────────────
  async function savePost() {
    if (!checkAuth()) return;

    var title   = document.getElementById('f-title').value.trim();
    var content = document.getElementById('f-content').value.trim();

    if (!title)   { showToast('Title is required', true); return; }
    if (!content) { showToast('Content is required', true); return; }

    var btn = document.getElementById('save-btn');
    btn.textContent = 'Saving...';
    btn.disabled = true;

    var payload = {
      title:    title,
      excerpt:  document.getElementById('f-excerpt').value.trim(),
      content:  content,
      category: document.getElementById('f-category').value,
      slug:     document.getElementById('f-slug').value.trim() || undefined,
      featured: document.getElementById('f-featured').checked,
    };

    try {
      var url    = editingSlug ? API + '/posts/' + editingSlug : API + '/posts';
      var method = editingSlug ? 'PUT' : 'POST';

      var res = await fetch(url, {
        method: method,
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer ' + token,
        },
        body: JSON.stringify(payload),
      });

      var data = await res.json();

      if (res.ok) {
        showToast(editingSlug ? 'Post updated!' : 'Post published!');
        clearEditor();
        showSection('posts');
        loadPosts();
      } else {
        showToast(data.error || 'Save failed', true);
        btn.textContent = editingSlug ? 'Update Post →' : 'Save Post →';
        btn.disabled = false;
      }
    } catch (e) {
      showToast('Network error. Try again.', true);
      btn.textContent = editingSlug ? 'Update Post →' : 'Save Post →';
      btn.disabled = false;
    }
  }

  // ── Delete post ───────────────────────────────────────────────────────────
  function deletePost(slug, title) {
    pendingDeleteSlug = slug;
    document.getElementById('delete-msg').textContent = '"' + title + '" will be permanently deleted. This cannot be undone.';
    document.getElementById('delete-overlay').classList.add('show');
  }

  function closeDeleteDialog() {
    pendingDeleteSlug = null;
    document.getElementById('delete-overlay').classList.remove('show');
  }

  async function confirmDelete() {
    if (!pendingDeleteSlug || !checkAuth()) return;
    var btn = document.getElementById('confirm-delete-btn');
    btn.textContent = 'Deleting...';
    btn.disabled = true;

    try {
      var res = await fetch(API + '/posts/' + pendingDeleteSlug, {
        method: 'DELETE',
        headers: { 'Authorization': 'Bearer ' + token },
      });
      if (res.ok) {
        showToast('Post deleted');
        closeDeleteDialog();
        loadPosts();
      } else {
        showToast('Delete failed', true);
      }
    } catch (e) {
      showToast('Network error', true);
    }
    btn.textContent = 'Delete permanently';
    btn.disabled = false;
  }

  // ── Helpers ───────────────────────────────────────────────────────────────
  function autoSlug() {
    if (editingSlug) return; // don't auto-update slug when editing
    var title = document.getElementById('f-title').value;
    var slug = title.toLowerCase()
      .replace(/[^a-z0-9\s-]/g, '')
      .replace(/\s+/g, '-')
      .replace(/-+/g, '-')
      .trim();
    document.getElementById('f-slug').value = slug;
  }

  function updateWordCount() {
    var content = document.getElementById('f-content').value;
    var words = content.trim() ? content.trim().split(/\s+/).length : 0;
    var mins = Math.max(1, Math.ceil(words / 200));
    document.getElementById('word-count').textContent = words.toLocaleString();
    document.getElementById('read-time').textContent = mins;
  }

  function clearEditor() {
    ['f-title','f-excerpt','f-content','f-slug'].forEach(function(id) {
      document.getElementById(id).value = '';
    });
    document.getElementById('f-category').value = 'Field Notes';
    document.getElementById('f-featured').checked = false;
    document.getElementById('editor-title').textContent = 'New Post';
    document.getElementById('editor-sub').textContent = 'Write a new field note';
    document.getElementById('save-btn').textContent = 'Save Post →';
    document.getElementById('save-btn').disabled = false;
    editingSlug = null;
    updateWordCount();
  }

  function cancelEdit() {
    clearEditor();
    showSection('posts');
  }

  function signOut() {
    sessionStorage.removeItem('sss_admin_token');
    window.location.href = '/admin';
  }

  function escHtml(str) {
    return String(str)
      .replace(/&/g,'&amp;')
      .replace(/</g,'&lt;')
      .replace(/>/g,'&gt;')
      .replace(/"/g,'&quot;');
  }

  // ── Init ──────────────────────────────────────────────────────────────────
  if (!checkAuth()) {
    // redirect handled in checkAuth
  } else {
    loadPosts();
  }
</script>

</body>
</html>
