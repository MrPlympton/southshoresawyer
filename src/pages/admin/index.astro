---
import Admin from '../../layouts/Admin.astro';
import { readFileSync } from 'fs';
import { resolve } from 'path';

const posts = JSON.parse(readFileSync(resolve('src/data/posts.json'), 'utf-8'));
const species = JSON.parse(readFileSync(resolve('src/data/species.json'), 'utf-8'));
---

<Admin title="Dashboard" section="dashboard">
  <!-- Stats row -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
    {[
      { label: 'Blog Posts', value: posts.length, href: '/admin/blog', color: 'border-amber' },
      { label: 'Species', value: species.length, href: '/admin/species', color: 'border-forest' },
      { label: 'Featured', value: posts.filter((p: any) => p.featured).length, href: '/admin/blog', color: 'border-amber/50' },
      { label: 'Unavailable', value: species.filter((s: any) => !s.available).length, href: '/admin/species', color: 'border-red-300' },
    ].map(stat => (
      <a href={stat.href}
         class={`bg-white border-t-2 ${stat.color} p-5 hover:shadow-md transition-shadow`}>
        <div class="font-display font-bold text-3xl text-forest">{stat.value}</div>
        <div class="font-mono text-[10px] text-steel/50 tracking-widest uppercase mt-1">{stat.label}</div>
      </a>
    ))}
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

    <!-- Recent posts -->
    <div class="bg-white border border-forest/10">
      <div class="flex items-center justify-between px-6 py-4 border-b border-forest/10">
        <h2 class="font-display font-bold text-forest">Recent Posts</h2>
        <a href="/admin/blog/new" class="eyebrow text-amber text-[10px] hover:text-amber/70">+ New Post</a>
      </div>
      <div class="divide-y divide-forest/5">
        {posts.slice(0, 5).map((post: any) => (
          <a href={`/admin/blog/${post.slug}`}
             class="flex items-center justify-between px-6 py-3 hover:bg-sawdust/30 transition-colors">
            <div>
              <div class="font-display text-sm font-bold text-forest leading-tight">{post.title}</div>
              <div class="font-mono text-[10px] text-steel/40 mt-0.5">{post.date} · {post.category}</div>
            </div>
            {post.featured && (
              <span class="font-mono text-[9px] text-amber tracking-widest uppercase bg-amber/10 px-2 py-1 ml-3 flex-shrink-0">
                Featured
              </span>
            )}
          </a>
        ))}
      </div>
      <div class="px-6 py-3 border-t border-forest/10">
        <a href="/admin/blog" class="font-mono text-[10px] text-steel/40 hover:text-amber transition-colors">
          View all {posts.length} posts →
        </a>
      </div>
    </div>

    <!-- Species list -->
    <div class="bg-white border border-forest/10">
      <div class="flex items-center justify-between px-6 py-4 border-b border-forest/10">
        <h2 class="font-display font-bold text-forest">Species</h2>
        <a href="/admin/species/new" class="eyebrow text-amber text-[10px] hover:text-amber/70">+ New Species</a>
      </div>
      <div class="divide-y divide-forest/5">
        {species.slice(0, 6).map((sp: any) => (
          <a href={`/admin/species/${encodeURIComponent(sp.name)}`}
             class="flex items-center justify-between px-6 py-3 hover:bg-sawdust/30 transition-colors">
            <div>
              <div class="font-display text-sm font-bold text-forest">{sp.name}</div>
              <div class="font-mono text-[10px] text-steel/40 italic">{sp.latin}</div>
            </div>
            <div class="flex items-center gap-2 ml-3 flex-shrink-0">
              <div class="flex gap-0.5">
                {[...Array(5)].map((_: any, i: number) => (
                  <div class={`w-1.5 h-1.5 rounded-full ${i < sp.rating ? 'bg-amber' : 'bg-forest/10'}`}></div>
                ))}
              </div>
              {!sp.available && (
                <span class="font-mono text-[9px] text-red-400">Unavailable</span>
              )}
            </div>
          </a>
        ))}
      </div>
      <div class="px-6 py-3 border-t border-forest/10">
        <a href="/admin/species" class="font-mono text-[10px] text-steel/40 hover:text-amber transition-colors">
          View all {species.length} species →
        </a>
      </div>
    </div>
  </div>

  <!-- Quick links -->
  <div class="mt-6 bg-white border border-forest/10 p-6">
    <h2 class="font-display font-bold text-forest mb-4">Quick Links</h2>
    <div class="flex flex-wrap gap-3">
      <a href="/" target="_blank" class="btn-secondary text-sm">View Site ↗</a>
      <a href="/blog" target="_blank" class="btn-secondary text-sm">Field Notes ↗</a>
      <a href="/species" target="_blank" class="btn-secondary text-sm">Species ↗</a>
      <a href="/calculator" target="_blank" class="btn-secondary text-sm">Calculator ↗</a>
    </div>
  </div>
</Admin>
