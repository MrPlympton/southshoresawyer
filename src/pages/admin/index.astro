---
// This page renders client-side only — no server auth here,
// credentials are validated by the Cloudflare Worker API.
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Login — South Shore Sawyer</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'IBM Plex Mono', monospace;
      background: #1C2E1C;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem;
      background-image: repeating-linear-gradient(
        180deg,
        transparent 0px, transparent 28px,
        rgba(200,136,26,0.04) 28px, rgba(200,136,26,0.04) 29px
      );
    }

    .card {
      background: #FAF6EE;
      width: 100%;
      max-width: 400px;
      border-top: 4px solid #C8881A;
      padding: 2.5rem;
    }

    .logo-wrap {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 2rem;
    }

    .logo-icon {
      width: 36px; height: 36px;
      background: #1C2E1C;
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }

    .logo-text { font-family: 'Playfair Display', serif; font-size: 16px; font-weight: 700; color: #1C2E1C; line-height: 1.2; }
    .logo-sub  { font-size: 9px; letter-spacing: 0.2em; text-transform: uppercase; color: #C8881A; margin-top: 2px; }

    h1 { font-family: 'Playfair Display', serif; font-size: 24px; color: #1C2E1C; margin-bottom: 6px; }
    .subtitle { font-size: 11px; color: #718096; letter-spacing: 0.05em; margin-bottom: 2rem; }

    label { display: block; font-size: 10px; letter-spacing: 0.15em; text-transform: uppercase; color: #4A5568; margin-bottom: 6px; }

    input[type="password"] {
      width: 100%;
      border: 1px solid rgba(28,46,28,0.2);
      background: #F7F0E4;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 16px;
      color: #1C2E1C;
      padding: 12px 16px;
      outline: none;
      transition: border-color 0.15s;
      margin-bottom: 1.5rem;
      letter-spacing: 0.1em;
    }
    input[type="password"]:focus { border-color: #C8881A; }

    .btn {
      width: 100%;
      background: #1C2E1C;
      color: #C8881A;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      padding: 14px;
      border: none;
      cursor: pointer;
      transition: background 0.15s;
    }
    .btn:hover { background: #3D2410; }
    .btn:disabled { opacity: 0.5; cursor: not-allowed; }

    .error {
      display: none;
      background: #FCEBEB;
      border: 1px solid #F09595;
      color: #A32D2D;
      font-size: 11px;
      padding: 10px 14px;
      margin-top: 12px;
      letter-spacing: 0.03em;
    }

    .back {
      display: block;
      text-align: center;
      margin-top: 1.5rem;
      font-size: 10px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #718096;
      text-decoration: none;
    }
    .back:hover { color: #1C2E1C; }
  </style>
</head>
<body>
  <div class="card">
    <div class="logo-wrap">
      <div class="logo-icon">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
          <circle cx="9" cy="9" r="7" stroke="#C8881A" stroke-width="1.5" fill="none"/>
          <circle cx="9" cy="9" r="2.5" fill="#C8881A"/>
          <line x1="9" y1="2" x2="9" y2="4" stroke="#C8881A" stroke-width="1.5" stroke-linecap="round"/>
          <line x1="9" y1="14" x2="9" y2="16" stroke="#C8881A" stroke-width="1.5" stroke-linecap="round"/>
          <line x1="2" y1="9" x2="4" y2="9" stroke="#C8881A" stroke-width="1.5" stroke-linecap="round"/>
          <line x1="14" y1="9" x2="16" y2="9" stroke="#C8881A" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </div>
      <div>
        <div class="logo-text">South Shore Sawyer</div>
        <div class="logo-sub">Admin Panel</div>
      </div>
    </div>

    <h1>Sign in</h1>
    <p class="subtitle">Enter your admin password to continue</p>

    <form id="login-form">
      <label for="password">Password</label>
      <input type="password" id="password" autocomplete="current-password" autofocus placeholder="••••••••••••" />
      <button type="submit" class="btn" id="login-btn">Sign in →</button>
      <div class="error" id="error-msg">Incorrect password. Try again.</div>
    </form>

    <a href="/" class="back">← Back to site</a>
  </div>

  <script is:inline>
    document.getElementById('login-form').addEventListener('submit', async function(e) {
      e.preventDefault();
      var password = document.getElementById('password').value;
      var btn = document.getElementById('login-btn');
      var errEl = document.getElementById('error-msg');

      btn.disabled = true;
      btn.textContent = 'Signing in...';
      errEl.style.display = 'none';

      try {
        var res = await fetch('/api/blog/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password: password }),
        });

        if (res.ok) {
          var data = await res.json();
          // Store token in sessionStorage — cleared when tab closes
          sessionStorage.setItem('sss_admin_token', data.token);
          window.location.href = '/admin/dashboard';
        } else {
          errEl.style.display = 'block';
          btn.disabled = false;
          btn.textContent = 'Sign in →';
          document.getElementById('password').value = '';
          document.getElementById('password').focus();
        }
      } catch (err) {
        errEl.textContent = 'Connection error. Check that the API worker is deployed.';
        errEl.style.display = 'block';
        btn.disabled = false;
        btn.textContent = 'Sign in →';
      }
    });

    // If already logged in, redirect straight to dashboard
    if (sessionStorage.getItem('sss_admin_token')) {
      window.location.href = '/admin/dashboard';
    }
  </script>
</body>
</html>
