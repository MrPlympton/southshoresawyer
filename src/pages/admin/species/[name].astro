---
export const prerender = false;
import Admin from '../../../layouts/Admin.astro';
import { readFileSync } from 'fs';
import { resolve } from 'path';

const { name } = Astro.params;
const allSpecies = JSON.parse(readFileSync(resolve('src/data/species.json'), 'utf-8'));
const sp = allSpecies.find((s: any) => s.name === decodeURIComponent(name!));

if (!sp) return Astro.redirect('/admin/species');
---

<Admin title={`Edit: ${sp.name}`} section="species">
  <div class="max-w-2xl">
    <a href="/admin/species" class="font-mono text-[10px] text-steel/40 hover:text-amber transition-colors mb-6 inline-block">
      ← Back to species
    </a>

    <div class="bg-white border border-forest/10 p-8">
      <form id="species-form" data-original-name={sp.name} class="space-y-5">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="font-mono text-[10px] text-steel/60 tracking-widest uppercase block mb-2">Common Name</label>
            <input name="name" type="text" required value={sp.name}
                   class="w-full border border-forest/15 font-display text-base text-forest px-4 py-3 focus:outline-none focus:border-amber transition-colors" />
          </div>
          <div>
            <label class="font-mono text-[10px] text-steel/60 tracking-widest uppercase block mb-2">Latin Name</label>
            <input name="latin" type="text" value={sp.latin}
                   class="w-full border border-forest/15 font-mono text-sm text-steel italic px-4 py-3 focus:outline-none focus:border-amber transition-colors" />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="font-mono text-[10px] text-steel/60 tracking-widest uppercase block mb-2">Rating (1–5)</label>
            <input name="rating" type="number" min="1" max="5" value={sp.rating}
                   class="w-full border border-forest/15 font-mono text-sm text-forest px-4 py-2.5 focus:outline-none focus:border-amber transition-colors" />
          </div>
          <div>
            <label class="font-mono text-[10px] text-steel/60 tracking-widest uppercase block mb-2">Drying Time</label>
            <input name="drying" type="text" value={sp.drying}
                   class="w-full border border-forest/15 font-mono text-sm text-forest px-4 py-2.5 focus:outline-none focus:border-amber transition-colors" />
          </div>
        </div>

        <div>
          <label class="font-mono text-[10px] text-steel/60 tracking-widest uppercase block mb-2">Best Uses</label>
          <input name="use" type="text" value={sp.use}
                 class="w-full border border-forest/15 font-mono text-sm text-forest px-4 py-2.5 focus:outline-none focus:border-amber transition-colors" />
        </div>

        <div>
          <label class="font-mono text-[10px] text-steel/60 tracking-widest uppercase block mb-2">Milling Notes</label>
          <textarea name="notes" rows={4}
                    class="w-full border border-forest/15 font-sans text-sm text-steel px-4 py-3 focus:outline-none focus:border-amber transition-colors resize-none">{sp.notes}</textarea>
        </div>

        <div class="flex items-center gap-3">
          <input type="checkbox" name="available" id="available" class="w-4 h-4 accent-amber"
                 checked={sp.available} />
          <label for="available" class="font-mono text-xs text-steel/60">Available locally on the South Shore</label>
        </div>

        <div class="pt-4 flex gap-3">
          <button type="submit" class="btn-primary">Update Species</button>
          <a href="/admin/species" class="btn-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</Admin>

<script>
  const form = document.getElementById('species-form');
  if (form) {
    const originalName = form.dataset.originalName;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form));
      const updated = {
        name: data.name,
        latin: data.latin || '',
        rating: Number(data.rating),
        drying: data.drying || '',
        use: data.use || '',
        notes: data.notes || '',
        available: 'available' in data,
      };
      const res = await fetch(`/api/species/${encodeURIComponent(originalName)}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(updated),
      });
      if (res.ok) window.location.href = '/admin/species';
      else alert('Failed to update species');
    });
  }
</script>
